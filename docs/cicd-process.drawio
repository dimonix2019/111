        <mxCell id="legend_title" value="Процесс CI/CD: от разработки до внедрения в Production" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#1a1a1a;fontFamily=Helvetica;" vertex="1" parent="1">
