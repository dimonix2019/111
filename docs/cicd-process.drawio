        <mxCell id="e_approve_up" value="Approve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#548235;fontSize=10;fontColor=#548235;fontStyle=1;exitX=0;exitY=0.5;entryX=1;entryY=1;" edge="1" parent="1" source="act_approve" target="act_check_appr">
