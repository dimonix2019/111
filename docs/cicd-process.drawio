        <!-- Конечное событие: релиз принят, процесс закрыт -->
        <mxCell id="ev_end" value="Успешный&#xa;релиз" style="ellipse;whiteSpace=wrap;html=1;fillColor=#82b366;fontColor=#ffffff;strokeColor=#1e4d2b;fontStyle=1;fontSize=11;strokeWidth=3;fontFamily=Helvetica;" vertex="1" parent="lane_prod">
          <mxGeometry x="3552" y="108" width="88" height="64" as="geometry"/>
