          <mxGeometry x="2480" y="12" width="1680" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="legend_label" value="Легенда:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2494" y="20" width="70" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lg_event" value="Событие&#xa;(старт / финиш)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2564" y="18" width="120" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="lg_task" value="Задача / шаг&#xa;процесса" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;arcSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2700" y="18" width="120" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="lg_auto" value="Автоматизация&#xa;(CI/CD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;arcSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2836" y="18" width="120" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="lg_gw" value="Шлюз&#xa;(условие)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2972" y="16" width="110" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="lg_rework" value="Доработка /&#xa;замечания" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;arcSize=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="3100" y="18" width="120" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="lg_ok" value="ДА / успех" style="endArrow=block;html=1;rounded=1;strokeWidth=2;strokeColor=#548235;fontSize=9;fontColor=#548235;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3250" y="32" as="sourcePoint"/>
            <mxPoint x="3360" y="32" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="lg_no" value="НЕТ / возврат" style="endArrow=block;html=1;rounded=1;strokeWidth=2;strokeColor=#b85450;dashed=1;dashPattern=8 4;fontSize=9;fontColor=#b85450;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3250" y="56" as="sourcePoint"/>
            <mxPoint x="3360" y="56" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="lg_wait" value="Ожидание / к QA" style="endArrow=block;html=1;rounded=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;dashPattern=6 3;fontSize=9;fontColor=#d79b00;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3380" y="44" as="sourcePoint"/>
            <mxPoint x="3510" y="44" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="lg_seq" value="Поток: слева направо по времени, сверху вниз по ролям" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="3530" y="28" width="280" height="32" as="geometry"/>
        </mxCell>

        <!-- ===================================================================
             ПУЛ: контейнер процесса. Title сверху, внутри — 5 дорожек.
             horizontal=1 → заголовок пула сверху.
             =================================================================== -->
        <mxCell id="pool" value="Единый конвейер поставки (CI/CD) — ответственность по ролям" style="swimlane;html=1;horizontal=1;startSize=40;fillColor=#2c3e50;fontColor=#ffffff;strokeColor=#1a252f;fontStyle=1;fontSize=14;fontFamily=Helvetica;whiteSpace=wrap;collapsible=0;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="88" width="3960" height="1280" as="geometry"/>
        </mxCell>

        <!-- ===================================================================
             ДОРОЖКА 1. Разработчик (Dev)
             horizontal=0 → заголовок слева (классический BPMN-swimlane).
             Логика: старт → код → push → MR. Правки — обработка возвратов
             от CI (красные проверки) и от QA (замечания ревью).
             =================================================================== -->
        <mxCell id="lane_dev" value="Разработчик (Dev)" style="swimlane;html=1;horizontal=0;startSize=48;fillColor=#1b4f72;fontColor=#ffffff;strokeColor=#1b4f72;swimlaneFillColor=#eaf2f8;fontStyle=1;fontSize=12;whiteSpace=wrap;collapsible=0;rounded=0;" vertex="1" parent="pool">
          <mxGeometry y="40" width="3960" height="180" as="geometry"/>
        </mxCell>

        <!-- Событие старта: инициирует весь процесс разработки фичи -->
        <mxCell id="ev_start" value="Старт&#xa;процесса" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="lane_dev">
          <mxGeometry x="72" y="56" width="72" height="72" as="geometry"/>
        </mxCell>

        <!-- Локальный цикл TDD/сборки до попадания кода в удалённый репозиторий -->
        <mxCell id="act_code" value="Написание кода&#xa;и локальная проверка" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_dev">
          <mxGeometry x="176" y="50" width="184" height="80" as="geometry"/>
        </mxCell>

        <!-- Триггер CI: push в feature-ветку запускает пайплайн ещё до MR -->
        <mxCell id="act_push" value="Git Push&#xa;в ветку фичи" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_dev">
          <mxGeometry x="392" y="50" width="176" height="80" as="geometry"/>
        </mxCell>

        <!-- MR/PR — точка входа ревью и обязательных статусов CI -->
        <mxCell id="act_pr" value="Создание&#xa;Pull Request (MR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_dev">
          <mxGeometry x="600" y="50" width="192" height="80" as="geometry"/>
        </mxCell>

        <!-- Обработчик возвратов: CI fail и/или комментарии QA. После правок — повторный push -->
        <mxCell id="act_fixes" value="Внесение исправлений&#xa;по замечаниям" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="lane_dev">
          <mxGeometry x="1540" y="50" width="208" height="80" as="geometry"/>
        </mxCell>

        <!-- ===================================================================
             ДОРОЖКА 2. CI/CD Система (Автоматизация)
             Срабатывает на Push и на обновление MR. Сначала quality-gate
             (тесты → линтеры → регламенты → YAML/SQL), затем gate аппрувов,
             затем auto-merge в защищённую ветку.
             =================================================================== -->
        <mxCell id="lane_ci" value="CI/CD Система (Автоматизация)" style="swimlane;html=1;horizontal=0;startSize=48;fillColor=#6c3483;fontColor=#ffffff;strokeColor=#6c3483;swimlaneFillColor=#f5eef8;fontStyle=1;fontSize=12;whiteSpace=wrap;collapsible=0;rounded=0;" vertex="1" parent="pool">
          <mxGeometry y="220" width="3960" height="270" as="geometry"/>
        </mxCell>

        <!-- Группа шагов 1–4: непрерывные проверки качества, без ручного участия -->
        <mxCell id="grp_ci_quality" value="Пайплайн CI — автоматические проверки качества" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=9;fontColor=#6c3483;fontStyle=2;" vertex="1" parent="lane_ci">
          <mxGeometry x="592" y="16" width="1048" height="112" as="geometry"/>
        </mxCell>

        <!-- Триггер job'ов: webhook Git Push / open·sync MR -->
        <mxCell id="act_pipeline" value="Запуск пайплайна CI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_ci">
          <mxGeometry x="608" y="40" width="168" height="72" as="geometry"/>
        </mxCell>

        <!-- Шаг 1: быстрый fail, если регрессия в unit/integration -->
        <mxCell id="act_tests" value="Шаг 1. Запуск автотестов&#xa;(Unit / Integration)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_ci">
          <mxGeometry x="792" y="40" width="184" height="72" as="geometry"/>
        </mxCell>

        <!-- Шаг 2: стиль, сложность, запрещённые API, секреты -->
        <mxCell id="act_linters" value="Шаг 2. Статический анализ&#xa;кода (Linters)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_ci">
          <mxGeometry x="992" y="40" width="184" height="72" as="geometry"/>
        </mxCell>

        <!-- Шаг 3: ключ задачи в ветке/MR, листинги, чек-лист регламента -->
        <mxCell id="act_regs" value="Шаг 3. Проверка соответствия&#xa;регламентам (ключи задач, листинги)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_ci">
          <mxGeometry x="1192" y="40" width="216" height="72" as="geometry"/>
        </mxCell>

        <!-- Шаг 4: валидность CI YAML и идемпотентность/синтаксис SQL -->
        <mxCell id="act_yaml" value="Шаг 4. Проверка YAML-&#xa;конфигураций и SQL-скриптов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_ci">
          <mxGeometry x="1424" y="40" width="200" height="72" as="geometry"/>
        </mxCell>

        <!-- Exclusive gateway: красный отчёт → Dev; зелёный → проверка аппрувов -->
        <mxCell id="gw_checks" value="Все проверки&#xa;пройдены?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;fontFamily=Helvetica;strokeWidth=1.5;" vertex="1" parent="lane_ci">
          <mxGeometry x="1664" y="28" width="128" height="100" as="geometry"/>
        </mxCell>

        <!-- Required reviewers + CODEOWNERS + QA/архитектура. Не мержит без кворума -->
        <mxCell id="act_check_appr" value="Шаг 5. Проверка наличия&#xa;всех обязательных аппрувов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_ci">
          <mxGeometry x="1860" y="164" width="216" height="72" as="geometry"/>
        </mxCell>

        <!-- Exclusive gateway: нет кворума — ждём QA; есть — auto-merge -->
        <mxCell id="gw_appr" value="Аппрувы&#xa;собраны?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;fontFamily=Helvetica;strokeWidth=1.5;" vertex="1" parent="lane_ci">
          <mxGeometry x="2112" y="152" width="120" height="96" as="geometry"/>
        </mxCell>

        <!-- Squash/merge в develop/master только при green CI + required approvals -->
        <mxCell id="act_merge" value="Автоматический Merge&#xa;(Auto-merge) в develop/master" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontFamily=Helvetica;arcSize=12;strokeWidth=2;" vertex="1" parent="lane_ci">
          <mxGeometry x="2272" y="164" width="224" height="72" as="geometry"/>
        </mxCell>

        <!-- ===================================================================
             ДОРОЖКА 3. Команда QA / Архитектура
             Человеческий контроль качества и границ системы. Approve закрывает
             gate аппрувов; комментарии возвращают работу разработчику.
             =================================================================== -->
        <mxCell id="lane_qa" value="Команда QA / Архитектура" style="swimlane;html=1;horizontal=0;startSize=48;fillColor=#9a7d0a;fontColor=#ffffff;strokeColor=#9a7d0a;swimlaneFillColor=#fef9e7;fontStyle=1;fontSize=12;whiteSpace=wrap;collapsible=0;rounded=0;" vertex="1" parent="pool">
          <mxGeometry y="490" width="3960" height="180" as="geometry"/>
        </mxCell>

        <!-- Ревью диффа: корректность, тесты, риски регрессии -->
        <mxCell id="act_review" value="Ревью кода&#xa;(Code Review)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_qa">
          <mxGeometry x="1860" y="28" width="176" height="64" as="geometry"/>
        </mxCell>

        <!-- Согласованность с целевой архитектурой, контрактами, NFR -->
        <mxCell id="act_arch" value="Проверка архитектурных&#xa;требований" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_qa">
          <mxGeometry x="2064" y="28" width="200" height="64" as="geometry"/>
        </mxCell>

        <!-- Approve в MR = голос в кворуме required reviews -->
        <mxCell id="act_approve" value="Оставление аппрува&#xa;(Approve) в MR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Helvetica;arcSize=12;strokeWidth=2;" vertex="1" parent="lane_qa">
          <mxGeometry x="2292" y="28" width="192" height="64" as="geometry"/>
        </mxCell>

        <!-- Request changes: блокирует merge, создаёт работу в дорожке Dev -->
        <mxCell id="act_comments" value="Комментарии и запрос правок" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="lane_qa">
          <mxGeometry x="1860" y="108" width="224" height="52" as="geometry"/>
        </mxCell>

        <!-- ===================================================================
             ДОРОЖКА 4. Релиз-менеджер / DevOps
             После merge в защищённую ветку: сборка артефактов, миграции,
             единый патч, отчёты, SR. Шлюз согласования — допуск в прод.
             =================================================================== -->
        <mxCell id="lane_rel" value="Релиз-менеджер / DevOps" style="swimlane;html=1;horizontal=0;startSize=48;fillColor=#b9770e;fontColor=#ffffff;strokeColor=#b9770e;swimlaneFillColor=#fef5e7;fontStyle=1;fontSize=12;whiteSpace=wrap;collapsible=0;rounded=0;" vertex="1" parent="pool">
          <mxGeometry y="670" width="3960" height="250" as="geometry"/>
        </mxCell>

        <!-- Группа технической сборки релиза (шаги 1–4) -->
        <mxCell id="grp_rel_build" value="Сборка релизного пакета" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#b9770e;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=9;fontColor=#b9770e;fontStyle=2;" vertex="1" parent="lane_rel">
          <mxGeometry x="2264" y="12" width="880" height="100" as="geometry"/>
        </mxCell>

        <!-- Старт релизного пайплайна по тегу / merge в master -->
        <mxCell id="act_init" value="Инициация&#xa;сборки релиза" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7a0;strokeColor=#b9770e;fontSize=11;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_rel">
          <mxGeometry x="2280" y="32" width="152" height="68" as="geometry"/>
        </mxCell>

        <!-- Шаг 1: бинарники, контейнеры, конфиги окружений -->
        <mxCell id="act_art" value="Шаг 1. Сборка артефактов&#xa;(бинарники, конфиги)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7a0;strokeColor=#b9770e;fontSize=10;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_rel">
          <mxGeometry x="2452" y="32" width="192" height="68" as="geometry"/>
        </mxCell>

        <!-- Шаг 2: changeset'ы Liquibase/Alembic, порядок и откат -->
        <mxCell id="act_mig" value="Шаг 2. Генерация скриптов&#xa;миграции БД (Liquibase/Alembic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7a0;strokeColor=#b9770e;fontSize=10;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_rel">
          <mxGeometry x="2664" y="32" width="224" height="68" as="geometry"/>
        </mxCell>

        <!-- Шаг 3: один артефакт поставки для внедренца -->
        <mxCell id="act_patch" value="Шаг 3. Формирование&#xa;единого релизного патча" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7a0;strokeColor=#b9770e;fontSize=10;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_rel">
          <mxGeometry x="2908" y="32" width="216" height="68" as="geometry"/>
        </mxCell>

        <!-- Шаг 4: вложения для аудита (SAST, покрытие, junit) -->
        <mxCell id="act_reports" value="Шаг 4. Генерация отчетов&#xa;(анализатор кода, тесты)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7a0;strokeColor=#b9770e;fontSize=10;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_rel">
          <mxGeometry x="2280" y="128" width="200" height="56" as="geometry"/>
        </mxCell>

        <!-- Регламентный тикет на изменение в промышленной среде -->
        <mxCell id="act_sr" value="Создание Service Request&#xa;(SR) / Тикета" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7a0;strokeColor=#b9770e;fontSize=10;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_rel">
          <mxGeometry x="2504" y="128" width="200" height="56" as="geometry"/>
        </mxCell>

        <!-- Комплект поставки: патч + отчёты прикладываются к SR -->
        <mxCell id="act_attach" value="Прикрепление патча&#xa;и отчетов к SR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7a0;strokeColor=#b9770e;fontSize=10;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_rel">
          <mxGeometry x="2728" y="128" width="184" height="56" as="geometry"/>
        </mxCell>

        <!-- CAB / релиз-менеджер: окно, риски, откат. Нет → rework Dev/DevOps -->
        <mxCell id="gw_rel" value="Согласован&#xa;ли релиз?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;fontFamily=Helvetica;strokeWidth=1.5;" vertex="1" parent="lane_rel">
          <mxGeometry x="2940" y="112" width="120" height="92" as="geometry"/>
        </mxCell>

        <!-- Ветка отказа согласования: правка состава патча / скриптов DevOps -->
        <mxCell id="act_rework" value="Исправление релиза (DevOps)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="lane_rel">
          <mxGeometry x="2504" y="196" width="216" height="40" as="geometry"/>
        </mxCell>

        <!-- ===================================================================
             ДОРОЖКА 5. Внедренец (Production)
             Только после согласования SR. Инфра → миграции БД → деплой →
             смоук. Успешный смоук закрывает процесс.
             =================================================================== -->
        <mxCell id="lane_prod" value="Внедренец (Production)" style="swimlane;html=1;horizontal=0;startSize=48;fillColor=#196f3d;fontColor=#ffffff;strokeColor=#196f3d;swimlaneFillColor=#eafaf1;fontStyle=1;fontSize=12;whiteSpace=wrap;collapsible=0;rounded=0;" vertex="1" parent="pool">
          <mxGeometry y="920" width="3960" height="200" as="geometry"/>
        </mxCell>

        <!-- Получение согласованного комплекта (патч + отчёты + SR) -->
        <mxCell id="act_recv" value="Получение патча&#xa;от Релиз-менеджера" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_prod">
          <mxGeometry x="3120" y="24" width="184" height="64" as="geometry"/>
        </mxCell>

        <!-- Диски, квоты, бэкап, окно обслуживания, доступы -->
        <mxCell id="act_infra" value="Проверка готовности&#xa;инфраструктуры" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_prod">
          <mxGeometry x="3328" y="24" width="184" height="64" as="geometry"/>
        </mxCell>

        <!-- Миграции ДО выкладки приложения, чтобы схема совпала с кодом -->
        <mxCell id="act_db" value="Применение&#xa;миграций БД" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_prod">
          <mxGeometry x="3536" y="24" width="168" height="64" as="geometry"/>
        </mxCell>

        <!-- Выкладка сервисов/приложений на промышленный контур -->
        <mxCell id="act_deploy" value="Деплой приложений&#xa;в Production" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_prod">
          <mxGeometry x="3120" y="108" width="184" height="64" as="geometry"/>
        </mxCell>

        <!-- Короткий прод-смоук: здоровье, ключевой сценарий, алерты -->
        <mxCell id="act_smoke" value="Смоук-тестирование&#xa;в прод" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Helvetica;arcSize=12;strokeWidth=1.5;" vertex="1" parent="lane_prod">
          <mxGeometry x="3328" y="108" width="184" height="64" as="geometry"/>
