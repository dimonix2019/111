        <mxCell id="e_r7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#b9770e;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="act_attach" target="gw_rel"><mxGeometry relative="1" as="geometry"/></mxCell>

